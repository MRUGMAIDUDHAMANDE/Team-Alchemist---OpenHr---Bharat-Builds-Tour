# ---------------------------------------------------------------------------
# OpenHR API - example environment
#
# Copy this file to `server/.env` and fill in the values produced by
# `npm run provision -w server` (or by hand in the AWS console).
# Never commit the real `.env`.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=4000
# Comma separated. Add your deployed client origin(s) later.
CORS_ORIGINS=http://localhost:3000

# AWS
# Prefer an IAM role in production (Lambda/ECS) and leave the keys blank there.
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Amazon Cognito User Pool (email as username, email auto-verified)
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
# Only set this if you created the app client WITH a secret.
COGNITO_CLIENT_SECRET=

# Amazon DynamoDB
DYNAMODB_USERS_TABLE=openhr-users
DYNAMODB_AVAILABILITY_TABLE=openhr-availability
DYNAMODB_REQUESTS_TABLE=openhr-requests
DYNAMODB_BOOKINGS_TABLE=openhr-bookings
DYNAMODB_REVIEWS_TABLE=openhr-reviews
DYNAMODB_MEDIA_TABLE=openhr-media
DYNAMODB_CONTACT_TABLE=openhr-contact
DYNAMODB_NOTIFICATIONS_TABLE=openhr-notifications

# Amazon SNS (event fan-out; leave empty to keep in-app notifications only)
SNS_TOPIC_ARN=
# Optional inbox that receives every event email (must confirm the subscription)
NOTIFICATION_EMAIL=

# Amazon Bedrock inference profile (natural-language search assistance only)
BEDROCK_MODEL_ID=apac.amazon.nova-micro-v1:0
BEDROCK_REGION=

# Amazon S3 (private media bucket - wired up in the media milestone)
S3_BUCKET_NAME=
S3_REGION=
